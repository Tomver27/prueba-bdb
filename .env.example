# Ver docs/BACKEND.md para el detalle de cada variable.

# Gemini API (tier gratuito) — https://aistudio.google.com/
GEMINI_API_KEY=

# Croma API — key de organización creada en https://platform.usecroma.com
CROMA_API_KEY=

# Opcional — default https://api.croma.run
CROMA_API_BASE_URL=https://api.croma.run

# Activar solo si no se pudo obtener una CROMA_API_KEY dentro del tiempo del reto.
# Cuando es true, las tools devuelven respuestas simuladas marcadas como "simulated": true.
CROMA_MOCK=false

# Timeout por llamada a Croma, en milisegundos
CROMA_TIMEOUT_MS=15000

# Máximo de llamadas a herramientas que el agente puede encadenar por pregunta
AGENT_MAX_TOOL_CALLS=4

NODE_ENV=development
